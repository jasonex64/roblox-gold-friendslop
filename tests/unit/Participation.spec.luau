--!strict
local Participation = require("../../src/shared/Pure/Participation")
local Crew = require("../../src/shared/Pure/Crew")
local Rewards = require("../../src/shared/Pure/RunRewards")
local Config = require("../../src/shared/Config")
local function setup()
	local crew = Crew.new(Config)
	crew.join("42")
	crew.join("7")
	crew.start(0)
	return crew, Participation.new(0, 600, crew.members(), Config)
end
return {
	["PARTICIPATION integrates AFK boundary without retroactive credit"] = function(t)
		local crew, p = setup()
		p.sample(200, crew)
		t.equal(p.participants["42"].activeSeconds, 70)
		crew.activity("42", 200)
		p.sample(250, crew)
		t.equal(p.participants["42"].activeSeconds, 120)
		p.sample(600, crew)
		t.equal(p.participants["42"].activeSeconds, 140)
		t.equal(p.participants["7"].activeSeconds, 70)
	end,
	["PARTICIPATION retains disconnected eligible recipients and locked crew size"] = function(t)
		local crew, p = setup()
		for now = 60, 480, 60 do
			p.sample(now, crew)
			crew.activity("42", now)
		end
		p.sample(490, crew)
		crew.leave("42")
		crew.join("99")
		local snapshot = p.finish("one", "rules", 12000, 700, crew)
		t.equal(snapshot.crewSize, 2)
		t.equal(snapshot.participants[42].activeSeconds, 490)
		t.equal(snapshot.participants[99], nil)
		local manifests = Rewards.build(snapshot, Config)
		t.equal(manifests[42].claimTokens, 32)
		t.equal(manifests[7].claimTokens, 0)
		t.errors(function()
			snapshot.participants[42].activeSeconds = 600
		end)
		t.errors(function()
			p.finish("one", "rules", 12000, 700, crew)
		end)
	end,
	["PARTICIPATION reveal shares discovery only with eligible members before bell"] = function(t)
		local crew, p = setup()
		t.equal(p.reveal({ id = "a", kind = "Gold Flakes" }, 60, crew), "revealed")
		t.equal(p.participants["7"].discoveries["Gold Flakes"], true)
		p.sample(70, crew)
		t.equal(p.reveal({ id = "b", kind = "Ruby" }, 70, crew), "revealed")
		t.equal(p.participants["42"].discoveries.Ruby, nil)
		crew.activity("42", 70)
		t.equal(p.reveal({ id = "b", kind = "Ruby" }, 71, crew), "duplicate")
		t.equal(p.participants["42"].discoveries.Ruby, nil)
		t.equal(p.reveal({ id = "c", kind = "Ruby" }, 71, crew), "revealed")
		t.equal(p.participants["42"].discoveries.Ruby, true)
		t.equal(p.participants["7"].discoveries.Ruby, nil)
		t.equal(p.reveal({ id = "d", kind = "Sapphire" }, 600, crew), "after_bell")
		local m = Rewards.build(p.finish("one", "rules", 0, 600, crew), Config)[42]
		t.equal(m.eligible, false)
		t.equal(m.claimTokens, 0)
		t.equal(m.discoveries.Ruby, true)
	end,
	["PARTICIPATION replay starts fresh and invalid chronology fails loudly"] = function(t)
		local crew, p = setup()
		p.sample(100, crew)
		t.errors(function()
			p.sample(99, crew)
		end)
		t.errors(function()
			p.finish("one", "rules", 0, 101, crew)
		end)
		local fresh = Participation.new(1000, 1600, { "42" }, Config)
		t.equal(fresh.participants["42"].activeSeconds, 0)
		t.equal(next(fresh.participants["42"].discoveries), nil)
	end,
}
